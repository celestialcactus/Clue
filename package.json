{
  "name": "desk-assistant",
  "version": "0.3.0",
  "description": "Private local document and research assistant",
  "author": "Clue",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "assets": "node scripts/prepare-assets.cjs",
    "assets:embeddings": "node scripts/prepare-embeddings.cjs",
    "build": "npm run ui:build && node scripts/check-assets.cjs && electron-builder --win nsis --x64",
    "ui:build": "node scripts/build-ui.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "cheerio": "1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "4.3.0",
    "@tailwindcss/oxide": "4.3.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.0"
  },
  "build": {
    "appId": "local.desk.assistant",
    "productName": "Clue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      ".renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/runtime",
        "to": "runtime"
      },
      {
        "from": "assets/model",
        "to": "model"
      },
      {
        "from": "assets/embeddings",
        "to": "embeddings"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
